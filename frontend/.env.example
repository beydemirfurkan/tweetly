# Backend API base URL — used by the panel for REST/MCP calls.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public URL the panel is reachable at — embedded in OAuth example snippets.
# Optional; falls back to a generic placeholder in code examples.
NEXT_PUBLIC_PANEL_URL=

# Comma-separated emails allowed to access the AI Copilot module from the panel.
# Must match the backend AI_COPILOT_ADMIN_EMAILS list. Empty = feature hidden.
NEXT_PUBLIC_AI_COPILOT_ADMIN_EMAILS=
