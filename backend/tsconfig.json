{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "paths": {
      "@modelcontextprotocol/sdk/server": ["node_modules/@modelcontextprotocol/sdk/dist/cjs/server/index.d.ts"],
      "@modelcontextprotocol/sdk/server/sse.js": ["node_modules/@modelcontextprotocol/sdk/dist/cjs/server/sse.d.ts"],
      "@modelcontextprotocol/sdk/types.js": ["node_modules/@modelcontextprotocol/sdk/dist/cjs/types.d.ts"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node", "jest"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true,
    "removeComments": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "data",
    "user-data",
    "src/**/*.spec.ts"
  ]
}
