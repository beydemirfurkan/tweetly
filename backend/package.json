{
  "name": "xtweetly",
  "version": "1.0.0",
  "description": "Multi-tenant X (Twitter) automation platform with MCP and REST API",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:cov": "jest --coverage --selectProjects unit",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "cycles": "madge --circular --extensions ts src/",
    "cycles:check": "node scripts/check-cycles.mjs",
    "cycles:baseline": "node scripts/check-cycles.mjs --update-baseline",
    "db:migrate": "npm run build --silent && node dist/scripts/run-migrations.js",
    "db:migrate:revert": "npm run build --silent && node dist/scripts/revert-migration.js",
    "db:migrate:legacy": "npm run build --silent && node dist/scripts/migrate-sqlite-to-postgres.js",
    "smoke:engine": "npm run build --silent && node dist/scripts/smoke-engine.js",
    "smoke:mcp": "tsx src/scripts/smoke-mcp-tools.ts",
    "smoke:rest": "tsx src/scripts/smoke-rest-tools.ts",
    "smoke:selectors": "tsx src/scripts/smoke-selectors.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "@scalar/nestjs-api-reference": "^1.1.13",
    "better-sqlite3": "^12.9.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "ioredis": "^5.10.1",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^8.0.7",
    "patchright": "^1.59.4",
    "pg": "^8.20.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.3.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0",
    "madge": "^8.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  }
}
