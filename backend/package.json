{
  "name": "tweetbot",
  "version": "1.0.0",
  "description": "GitHub Trending repos için Türkçe tweet otomasyonu",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch",
    "db:migrate": "npm run build --silent && node dist/scripts/run-migrations.js",
    "db:migrate:revert": "npm run build --silent && node dist/scripts/revert-migration.js",
    "db:migrate:legacy": "npm run build --silent && node dist/scripts/migrate-sqlite-to-postgres.js",
    "smoke:engine": "npm run build --silent && node dist/scripts/smoke-engine.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "better-sqlite3": "^12.9.0",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^17.4.2",
    "nestjs-pino": "^4.6.1",
    "node-cron": "^3.0.3",
    "patchright": "^1.59.4",
    "pg": "^8.20.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
