# Required production env. Never commit real values.

# Real X posting requires patchright. Use noop only for local dry-runs.
X_EXECUTOR_MODE=patchright

# One-time bootstrap only. After setting secrets.admin_token in DB, remove it.
BOOTSTRAP_ADMIN_TOKEN=

DATABASE_URL=

# Public URL the panel is reachable at.
APP_URL=http://localhost:3000

# ── Clerk auth ───────────────────────────────────────────────────────────
# Required for the web panel. Get these from https://dashboard.clerk.com.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Webhook signing secret from the Clerk dashboard endpoint config.
# Required for /auth/clerk-webhook (handles user.deleted -> suspend local user).
CLERK_WEBHOOK_SECRET=
# Optional: PEM-encoded JWKS public key for networkless JWT verification.
# When set, no API call is made to fetch JWKS during token verify.
CLERK_JWT_KEY=
# Optional comma-separated list of authorized frontend origins (azp claim).
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# 32-byte master key used to encrypt X account credentials (password / TOTP
# secret) at rest with AES-256-GCM. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Accepted formats: base64 (44 chars) or hex (64 chars). Required at boot.
# Rotating this key invalidates all stored login credentials and pending
# login jobs — pasted X session cookies remain valid.
ENCRYPTION_KEY=

# Mail delivery (provider, host, credentials, from address) is configured
# at runtime through PUT /admin/secrets and stored in the settings table —
# never in env. Reserved for future transactional email; auth emails are
# fully handled by Clerk.

# CORS origin whitelist (comma-separated). Empty value = reject all browser
# origins in production / allow all in development.
CORS_ORIGINS=https://panel.yourdomain.com

# Redis is only required when running multiple Tweetly instances behind a
# load balancer. Single-instance deployments can leave it empty and the
# rate-limiter / MCP session router fall back to in-memory mode.
REDIS_URL=

# Admin-only browser diagnostics/probe endpoints. Keep false in customer-facing
# environments unless actively investigating a production runtime issue.
ADMIN_DEBUG_ENDPOINTS_ENABLED=false

# Local smoke harness inputs. Safe read-only suites are default; queue/write
# tests require TWEETLY_ALLOW_WRITE_SMOKE=true, destructive direct tools require
# TWEETLY_ALLOW_DESTRUCTIVE_SMOKE=true.
TWEETLY_BASE_URL=http://localhost:3001
TWEETLY_API_KEY=
TWEETLY_ACCOUNT_ID=
TWEETLY_TARGET_HANDLE=
TWEETLY_TARGET_TWEET_URL=
