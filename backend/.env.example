# Required production env. Never commit real values.

# Real X posting requires patchright. Use noop only for local dry-runs.
X_EXECUTOR_MODE=patchright

DATABASE_URL=

# Public URL the panel is reachable at — magic-link emails embed this.
APP_URL=http://localhost:3000

# 32-byte master key (base64 or hex) for AES-256-GCM encryption of X
# account credentials. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required at boot. Rotating invalidates stored login credentials.
ENCRYPTION_KEY=

# CORS origin whitelist (comma-separated). Empty = reject all in prod.
CORS_ORIGINS=https://panel.yourdomain.com

# Optional. Required only when running multiple instances behind a load
# balancer; single-instance deployments fall back to in-memory.
REDIS_URL=

# One-time bootstrap. After setting secrets.admin_token in DB, remove.
BOOTSTRAP_ADMIN_TOKEN=

# Mail delivery (provider, host, credentials, from address) is configured
# at runtime through PUT /admin/secrets and stored in the settings table —
# never in env. Default mode is "console" (link logged to stdout) until
# you configure SMTP.

# Admin browser diagnostics. Keep false unless investigating a runtime issue.
ADMIN_DEBUG_ENDPOINTS_ENABLED=false
