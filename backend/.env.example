# Required production env. Never commit real values.

# Real X posting requires patchright. Use noop only for local dry-runs.
X_EXECUTOR_MODE=patchright

# One-time bootstrap only. After setting secrets.admin_token in DB, remove it.
BOOTSTRAP_ADMIN_TOKEN=

DATABASE_URL=

# Email delivery for magic links.
#   console  → log link to stdout (dev default)
#   smtp     → send via SMTP relay (Postmark, Mailgun, SES, Gmail, etc.)
MAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Tweetly <noreply@yourdomain.com>

# Public URL the panel is reachable at — magic-link emails embed this.
APP_URL=http://localhost:3000
