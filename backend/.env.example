# Required production env. Never commit real values.

# Real X posting requires patchright. Use noop only for local dry-runs.
X_EXECUTOR_MODE=patchright

DATABASE_URL=

# Public URL the panel is reachable at — magic-link emails embed this.
APP_URL=https://xtweetly.com

# Optional. Public URL the backend itself is reachable at — embedded in
# OAuth metadata (/.well-known/oauth-protected-resource, etc.). When unset,
# falls back to deriving from X-Forwarded-Host / X-Forwarded-Proto on the
# inbound request, which works behind Coolify, nginx, or Cloudflare. Set
# explicitly only if your reverse proxy strips those headers.
PUBLIC_BACKEND_URL=https://api.xtweetly.com

# 32-byte master key (base64 or hex) for AES-256-GCM encryption of X
# account credentials AND X session cookies (auth_token, ct0, twid).
# Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required at boot. Rotating invalidates stored login credentials and
# session cookies — see README "Rotating ENCRYPTION_KEY" for the
# parallel-decrypt migration runbook.
ENCRYPTION_KEY=

# CORS origin whitelist (comma-separated). Empty = reject all in prod.
CORS_ORIGINS=https://xtweetly.com

# Express `trust proxy` value, controls how req.ip resolves behind a proxy.
# Default `loopback` trusts only 127.0.0.1 / ::1. Set this when the backend
# sits behind a reverse proxy / load balancer so IP-based rate limits
# (magic-link, OAuth DCR) reflect the real client instead of the proxy.
#   nginx / Coolify (single hop):    TRUST_PROXY=loopback,linklocal,uniquelocal
#   Cloudflare (CF-Connecting-IP):   TRUST_PROXY=loopback,linklocal,uniquelocal
#   AWS ALB / Vercel / Fly.io:       TRUST_PROXY=1   # one upstream hop
# Accepts boolean, integer (hop count), IP/subnet list, or named tokens.
# See https://expressjs.com/en/guide/behind-proxies.html
# TRUST_PROXY=loopback

# Optional. Required only when running multiple instances behind a load
# balancer; single-instance deployments fall back to in-memory.
REDIS_URL=

# Webhook SSRF allowlist / blocklist (comma-separated hostnames). The
# validator rejects any URL that resolves to a private / loopback / link-
# local / metadata IP by default; use these to carve known exceptions.
#   WEBHOOK_HOST_ALLOWLIST=hooks.internal.acme.test
#   WEBHOOK_HOST_BLOCKLIST=evil.example
# Allow http:// webhooks in production (default: https only).
#   ALLOW_HTTP_WEBHOOK=true

# Queue workers.
WORKER_DISABLED=false
WORKER_POLL_MS=3000
WORKER_BATCH_SIZE=1
WORKER_LOCK_TTL_SEC=300
ACTION_PRIORITY_ENABLED=false

# Account monitoring.
MONITOR_POLLING_ENABLED=true
MONITOR_POLL_INTERVAL_MS=600000

# Async extraction jobs.
EXTRACTION_WORKER_DISABLED=false
EXTRACTION_WORKER_POLL_MS=5000
EXTRACTION_WORKER_BATCH_SIZE=50
EXTRACTION_WORKER_LOCK_TTL_SEC=300
EXTRACTIONS_DIR=

# One-time bootstrap. After setting secrets.admin_token in DB, remove.
BOOTSTRAP_ADMIN_TOKEN=

# Mail delivery (provider, host, credentials, from address) is configured
# at runtime through PUT /admin/secrets and stored in the settings table —
# never in env. Default mode is "console" (link logged to stdout) until
# you configure SMTP.

# Admin browser diagnostics. Keep false unless investigating a runtime issue.
ADMIN_DEBUG_ENDPOINTS_ENABLED=false

# X browser/login diagnostics and optional browser selection.
HEADLESS=true
DATA_DIR=
USER_DATA_DIR=
PLAYWRIGHT_BROWSERS_PATH=
PATCHRIGHT_BROWSER_CHANNEL=
PATCHRIGHT_RELEASE_TIMEOUT_MS=
STRICT_SESSION_HEALTH_ENABLED=true
LOGIN_WORKER_DISABLED=false
LOGIN_WORKER_POLL_MS=3000
LOGIN_WORKER_RETRY_DELAY_MS=30000
LOGIN_WORKER_LOCK_TTL_SEC=300
LOGIN_STEP_TIMEOUT_MS=20000
LOGIN_NAV_TIMEOUT_MS=45000
LOGIN_DEBUG_HEADFUL=false
LOGIN_DEBUG_SLOWMO_MS=0
LOGIN_DEBUG_ARTIFACTS=true
LOGIN_DEBUG_DIR=
LOGIN_USER_AGENT=

# Legacy SQLite migration helper only.
SQLITE_DB_PATH=

# Comma-separated emails authorised to use the AI Copilot module.
# Empty = feature disabled (any caller gets 403).
AI_COPILOT_ADMIN_EMAILS=
