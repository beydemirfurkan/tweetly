# X (Twitter) Cookie-based auth — only X_AUTH_TOKEN is required
# Get auth_token from your logged-in browser cookies (devtools → Application → Cookies)
# Never commit real values.
X_AUTH_TOKEN=

# X account username — used as account ID in multi-account setup
# If not set, a short ID is auto-generated from auth_token
# X_USERNAME=

# AI tweet generation via OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-2.5-flash

# Admin API token (for /admin/* endpoints)
ADMIN_TOKEN=

# PostgreSQL — required for all persistence
DB_HOST=localhost
DB_PORT=5432
DB_USER=tweetly
DB_PASS=tweetly
DB_NAME=tweetly
# DB_SSL=false
# DB_SCHEMA=public
# DB_LOGGING=false

# App port (default: 3001 locally, 3000 in Docker via docker-compose)
# NEST_PORT=3001

# Pipeline tuning (optional — defaults shown)
# TWEETS_PER_DAY=13
# Real X posting requires patchright. Use noop only for dry-run/dev.
# X_EXECUTOR_MODE=patchright
# WORKER_POLL_MS=3000
# WORKER_BATCH_SIZE=1
# WORKER_LOCK_TTL_SEC=300
# HEADLESS=true

# SQLite -> Postgres one-time migration
# SQLITE_DB_PATH=./data/tweetly.db
