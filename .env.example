# X (Twitter) Session — Cookie-based auth (primary method)
# Only X_AUTH_TOKEN is required. ct0/twid are auto-captured after first login.
# Get auth_token from your logged-in browser cookies. Never commit real values.
X_AUTH_TOKEN=
# X_AUTH_MULTI=
# X_CT0=
# X_TWID=

# X account username — optional, used as account ID in multi-account setup
# If not set, a short ID is auto-generated from auth_token
# X_USERNAME=

# X Login (password-based, only for npm run login — not needed for cookie auth)
# X_PASSWORD=

# AI tweet generation via OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-2.5-flash

# Admin API token (for /status, /settings, /accounts endpoints)
ADMIN_TOKEN=

# Pipeline tuning (optional — defaults shown)
# TWEETS_PER_DAY=13
# DISPATCH_START_HOUR=9
# MAX_ATTEMPTS=3
# PORT=3000
# HEADLESS=true

# NestJS (Faz 0+) — paralel uygulama portu (legacy 3000 ile çakışmaması için)
# NEST_PORT=3001

# PostgreSQL (Faz 1+) — NestJS uygulamasının persistence katmanı
DB_HOST=localhost
DB_PORT=5432
DB_USER=tweetly
DB_PASS=tweetly
DB_NAME=tweetly
# DB_SSL=false
# DB_SCHEMA=public
# DB_LOGGING=false

# SQLite -> Postgres migration scripti yolu (Faz 1)
# SQLITE_DB_PATH=./data/tweetly.db
