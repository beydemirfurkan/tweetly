X_USERNAME=your_x_username
X_PASSWORD=your_x_password
HEADLESS=false

# Optional but recommended for Coolify: import an existing X browser session on startup.
# Get these from your own logged-in browser cookies. Never commit real values.
X_AUTH_TOKEN=
X_AUTH_MULTI=
X_CT0=
X_TWID=

OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_REFERER=https://github.com/tweetbot
OPENROUTER_APP_NAME=tweetbot

TWEETS_PER_DAY=10
DISPATCH_START_HOUR=9
MAX_ATTEMPTS=3
